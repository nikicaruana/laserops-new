# Public site URL — used for canonical tags, sitemap, OG images
NEXT_PUBLIC_SITE_URL=https://laseropsmalta.com

# Google Tag Manager — leave blank to disable tracking entirely
# Format: GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=

# Cloudinary — powers the /gallery page.
# Create a free account at cloudinary.com, then find these under
# Settings → Access Keys. All three are required; missing any one
# disables the gallery (empty state shown instead of crashing).
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Optional: restrict the gallery to a specific folder and its subfolders.
# Without this, all images in the account are fetched.
# Example: laseropsmalta.com/Gallery
CLOUDINARY_GALLERY_FOLDER=

# Supabase — powers the 2.0 player portal (auth + stats data).
# Find these under Project Settings → API in the Supabase dashboard.
# The URL and anon key are PUBLIC (safe in the browser) — every table is
# guarded by Row-Level Security. Missing them disables the portal's auth.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key

# Resend — powers the /booking enquiry form.
# Create a free account at resend.com, verify laseropsmalta.com as a sending
# domain, then copy the API key from the dashboard.
# Without this the form returns a 500 and no email is sent.
RESEND_API_KEY=re_...

# ---------------------------------------------------------------------------
# Payments. The app talks to a provider-agnostic interface (lib/payments), so
# switching processors is one env change. PAYMENT_PROVIDER selects the active
# processor for NEW checkouts; a payment is always refunded via the processor
# that captured it. Blank = first configured provider (Stripe preferred).
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER=

# Stripe (use test keys in dev). Dashboard: Developers > API keys / Webhooks.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Viva.com Smart Checkout. Use the DEMO environment for the sandbox
# (demo.vivapayments.com). You need, from the Viva demo dashboard:
#   VIVA_CLIENT_ID / VIVA_CLIENT_SECRET  - Smart Checkout OAuth2 credentials
#   VIVA_MERCHANT_ID / VIVA_API_KEY      - Basic-auth pair (refunds + webhook key)
#   VIVA_SOURCE_CODE                     - the payment Source for this site; the
#                                          Source also holds the success/failure/
#                                          cancel redirect URLs.
# Then register a webhook pointing at <site>/api/viva/webhook (it answers Viva's
# GET verification), and set PAYMENT_PROVIDER=viva to make Viva the active one.
VIVA_ENV=demo
VIVA_CLIENT_ID=
VIVA_CLIENT_SECRET=
VIVA_MERCHANT_ID=
VIVA_API_KEY=
VIVA_SOURCE_CODE=

# Future env vars (documented here for reference, not yet wired up):
# NEXT_PUBLIC_BOOKING_PROVIDER_URL=
# GOOGLE_SHEETS_ID=
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Closed-group staging gate (set ONLY on the Vercel staging deployment; leave unset in prod)
# STAGING_GATE=1
# STAGING_ALLOWED_EMAILS=you@example.com,@laseropsmalta.com
